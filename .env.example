# ============================================================
# 工大智政 · 环境变量示例
#
# 用法：复制本文件为 .env 后再填写
#     Windows cmd :  copy .env.example .env
#     PowerShell  :  Copy-Item .env.example .env
#     macOS/Linux :  cp .env.example .env
#
# 说明：
#   * 所有变量都有默认值（见 config.py），不设也能启动；
#     但下面标注「必填」的两项不填就连不上模型。
#   * .env 已被 .gitignore 忽略，不会进入版本库，请勿把它提交上去。
# ============================================================

# ---------- 大模型服务（火山引擎方舟）—— 必填 ----------
# 1) ARK_API_KEY：向队长索取（他会私下单独发给你），把密钥粘贴到等号后面
#    ⚠️ 这是队长账号的密钥，请当密码对待：
#      不要提交到 git、不要发到群里、不要打进要转发给别人的压缩包
ARK_API_KEY=
# 2) ARK_MODEL：推理接入点 ID
#    Key 和接入点必须属于同一个账号。队长的 Key 配他账号的接入点，
#    而那个接入点已作为默认值写在 config.py 里，所以这里【留空即可】自动匹配。
#    仅当队长另外单独发给你一个接入点 ID 时，才填在这里（形如 ep-20260101000000-xxxxx）
ARK_MODEL=

# ---------- 以下都有默认值，按需覆盖（不填即用默认） ----------
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 审查链路可单独指定更快的接入点，默认沿用 ARK_MODEL
# REVIEW_MODEL=
# FACT_MODEL=
# SOFT_REVIEW_MODEL=
# 只有当所在网络必须走代理才能访问方舟时，才设为 0
# ARK_BYPASS_PROXY=1
# 模型客户端自动重试次数（默认 0，让每次调用耗时有确定上界）
# ARK_MAX_RETRIES=0

# ---------- 领域配置 ----------
# 使用 domains/<名字>.yaml；换一所学校只改这一项
# DOMAIN_NAME=gdut

# ---------- 检索与生成 ----------
# RETRIEVE_VECTOR_K=20
# RETRIEVE_BM25_K=20
# RERANK_POOL=10
# RERANK_TOP_N=5
# CACHE_ENABLED=1
# CACHE_SIZE=128

# ---------- 材料审查 ----------
# REVIEW_MAX_MB=20
# TIMEOUT_REVIEW=60
# REVIEW_RETRIES=1
# REVIEW_MAX_TOKENS=8000
# MAX_APPLICABLE_RULES=30

# ---------- 登录与账号 ----------
# AUTH_ENABLED=1
# AUTH_DEMO_PASSWORD=Demo@123456
# 部署到公网前请设置强密码，并在建好正式账号后设为 0 以停止自动建号
# AUTH_BOOTSTRAP_DEMO_USERS=1
# 公网 HTTPS 部署时设为 1
# AUTH_COOKIE_SECURE=0
# AUTH_SESSION_DAYS=7

# ---------- 本地模型与向量库 ----------
# 国内默认走 hf-mirror 镜像
# HF_ENDPOINT=https://hf-mirror.com
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-base
# CHROMA_DIR=./chroma_db
